<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fundo"
    android:orientation="vertical"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    tools:context=".MainActivity" >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp" >

        <TextView
            android:id="@+id/txtTextoInicial"
            style="@style/TextoInicial"
            android:text="@string/texto_inicial" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/shape_linear"
        android:orientation="vertical" >

        <TableLayout style="@style/TableLayouts" >

            <TableRow
                android:id="@+id/tableRow1"
                style="@style/TableRows" >

                <Button
                    android:id="@+id/btnSoma"
                    android:textColor="#000000"
                    style="@style/Buttons"
                    android:layout_width="match_parent"
                    android:onClick="onClick"
                    android:text="@string/soma" />

                <Button
                    android:id="@+id/btnSubtrai"
                    style="@style/Buttons"
                    android:layout_width="match_parent"
                    android:onClick="onClick"
                    android:text="@string/subtracao"
                    android:textColor="#000000" />

            </TableRow>

            <TableRow
                android:id="@+id/tableRow2"
                style="@style/TableRows" >

                <Button
                    android:id="@+id/btnMultiplica"
                    android:textColor="#000000"
                    style="@style/Buttons"
                    android:onClick="onClick"
                    android:text="@string/multiplicacao" />

                <Button
                    android:id="@+id/btnMultiplicaMatrizes"
                    style="@style/Buttons"
                    android:onClick="onClick"
                    android:text="@string/multiplicacao_matrizes"
                    android:textColor="#000000" />

            </TableRow>
        </TableLayout>
    </LinearLayout>

</LinearLayout>